{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "SFPilot",
  "version": "3.0.0",
  "description": "SFPilot - Your Salesforce co-pilot for navigation, log analysis, debugging, and org management",
  "icons": {
    "16": "icons/Spotlite-Icon-16.png",
    "32": "icons/Spotlite-Icon-32.png",
    "48": "icons/Spotlite-Icon-48.png",
    "128": "icons/Spotlite-Icon-128.png"
  },
    "action": {
    "default_title": "SFPilot",
    "default_icon": {
      "16": "icons/Spotlite-Icon-16.png",
      "32": "icons/Spotlite-Icon-32.png",
      "48": "icons/Spotlite-Icon-48.png",
      "128": "icons/Spotlite-Icon-128.png"
    }
  },
  "options_page": "navigator/settings.html",
  "commands": {
    "open_navigator": {
      "suggested_key": { "default": "Alt+N", "mac": "Alt+N" },
      "description": "Open the Navigator popup (orgs, bookmarks, objects)"
    },
    "open_command_palette": {
      "suggested_key": { "default": "Alt+K", "mac": "Alt+K" },
      "description": "Open the Navigator command palette"
    },
    "navigate_to_setup": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Go to Salesforce Setup"
    },
    "navigate_to_home": {
      "suggested_key": { "default": "Alt+A", "mac": "Alt+A" },
      "description": "Go to the current app's Salesforce Home"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "cookies",
    "contextMenus",
    "tabGroups"
  ],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.force.com/*",
    "https://*.cloudforce.com/*",
    "https://*.visualforce.com/*",
    "https://*.sfcrmapps.cn/*",
    "https://*.sfcrmproducts.cn/*",
    "https://*.salesforce.mil/*",
    "https://*.force.mil/*",
    "https://*.cloudforce.mil/*",
    "https://*.visualforce.mil/*",
    "https://*.crmforce.mil/*",
    "https://*.force.com.mcas.ms/*",
    "https://*.builder.salesforce-experience.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://dashscope-intl.aliyuncs.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.visual.force.com/*",
        "https://*.vf.force.com/*",
        "https://*.lightning.force.com/*",
        "https://*.cloudforce.com/*",
        "https://*.visualforce.com/*",
        "https://*.sfcrmapps.cn/*",
        "https://*.sfcrmproducts.cn/*",
        "https://*.salesforce.mil/*",
        "https://*.visual.force.mil/*",
        "https://*.vf.force.mil/*",
        "https://*.lightning.force.mil/*",
        "https://*.cloudforce.mil/*",
        "https://*.visualforce.mil/*",
        "https://*.crmforce.mil/*",
        "https://*.lightning.force.com.mcas.ms/*",
        "https://*.force.com/*",
        "https://*.builder.salesforce-experience.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.visual.force.com/*",
        "https://*.vf.force.com/*",
        "https://*.lightning.force.com/*",
        "https://*.cloudforce.com/*",
        "https://*.visualforce.com/*",
        "https://*.sfcrmapps.cn/*",
        "https://*.sfcrmproducts.cn/*",
        "https://*.salesforce.mil/*",
        "https://*.visual.force.mil/*",
        "https://*.vf.force.mil/*",
        "https://*.lightning.force.mil/*",
        "https://*.cloudforce.mil/*",
        "https://*.visualforce.mil/*",
        "https://*.crmforce.mil/*",
        "https://*.lightning.force.com.mcas.ms/*",
        "https://*.force.com/*",
        "https://*.builder.salesforce-experience.com/*"
      ],
      "js": ["content-ui.js", "ai-agent.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.my.salesforce-setup.com/*"
      ],
      "js": [
        "navigator/src/shared/sfUrl.js",
        "navigator/src/shared/settings.js",
        "navigator/src/shared/orgs.js",
        "navigator/src/shared/orgColors.js",
        "navigator/src/content/orgFavicon.js",
        "navigator/src/content/contentSetup.js",
        "navigator/src/content/headerButton.js",
        "navigator/src/shared/setupPages.js",
        "navigator/src/shared/recents.js",
        "navigator/src/content/commandPalette.data.js",
        "navigator/src/content/commandPalette.js"
      ],
      "css": ["navigator/styles/setupStyle.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "sfpilot.html", "chunks/*", "*.js", "*.css", "assets/*", "icons/*", "navigator/images/*", "navigator/fonts/*"],
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.visual.force.com/*",
        "https://*.vf.force.com/*",
        "https://*.lightning.force.com/*",
        "https://*.cloudforce.com/*",
        "https://*.visualforce.com/*",
        "https://*.sfcrmapps.cn/*",
        "https://*.sfcrmproducts.cn/*",
        "https://*.salesforce.mil/*",
        "https://*.visual.force.mil/*",
        "https://*.vf.force.mil/*",
        "https://*.lightning.force.mil/*",
        "https://*.cloudforce.mil/*",
        "https://*.visualforce.mil/*",
        "https://*.crmforce.mil/*",
        "https://*.lightning.force.com.mcas.ms/*",
        "https://*.force.com/*",
        "https://*.builder.salesforce-experience.com/*"
      ]
    }
  ],
  "incognito": "spanning"
}
